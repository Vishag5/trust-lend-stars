VITE_APP_MODE=demo
VITE_APP_ENV=development
VITE_SUPABASE_URL=your_demo_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_demo_key
VITE_APP_DEBUG=true
VITE_APP_MOCK_DATA=true

# Feature Flags (Demo Mode)
VITE_ENABLE_SECURITY_TESTS=true
VITE_ENABLE_UIUX_TESTS=true
VITE_ENABLE_DEBUG_PANEL=true
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_GUEST_ACCESS=true

# Demo Mode Settings
VITE_DEMO_MODE=true
VITE_SKIP_AUTH=true
VITE_SHOW_DEBUG_INFO=true
VITE_ENABLE_LOGGING=true
